{
  "$schema": "http://json.schemastore.org/template",
  "author": "ПНВ",
  "classifications": [
    "Web",
    "AspNetCore",
    "C#"
  ],
  "description": "Веб-приложение на ASP.NET Core Minimal API (.NET 10, C# 14) с выбором фронтенда, архитектуры, EF Core (PostgreSQL), Serilog, user-секретов, Docker, тестов и скиллов.",
  "groupIdentity": "Pnv.Templates.Web",
  "identity": "Pnv.Templates.Web",
  "name": "ПНВ: ВебПриложение",
  "shortName": "pnv-web",
  "sourceName": "Pnv.Web",
  "defaultName": "PnvWeb",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Frontend": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": false,
      "description": "Фронтенд веб-приложения.",
      "displayName": "Фронтенд",
      "choices": [
        {
          "choice": "None",
          "description": "Без фронтенда: только REST API.",
          "displayName": "Без фронтенда"
        },
        {
          "choice": "RazorPages",
          "description": "Razor Pages в том же проекте, без папки Frontend.",
          "displayName": "Razor Pages"
        },
        {
          "choice": "RazorPagesVue",
          "description": "Razor Pages + Vue (TypeScript) в том же проекте.",
          "displayName": "Razor Pages + Vue"
        },
        {
          "choice": "RazorPagesReact",
          "description": "Razor Pages + React (TypeScript) в том же проекте.",
          "displayName": "Razor Pages + React"
        },
        {
          "choice": "BlazorWasm",
          "description": "Blazor WebAssembly в папке Frontend + REST API.",
          "displayName": "Blazor WebAssembly"
        },
        {
          "choice": "BlazorServer",
          "description": "Blazor Server в папке Frontend + REST API.",
          "displayName": "Blazor Server"
        },
        {
          "choice": "React",
          "description": "React SPA (TypeScript, Vite) в папке Frontend + REST API.",
          "displayName": "React"
        },
        {
          "choice": "Vue",
          "description": "Vue SPA (TypeScript, Vite) в папке Frontend + REST API.",
          "displayName": "Vue"
        }
      ],
      "defaultValue": "RazorPages"
    },
    "Architecture": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": false,
      "description": "Архитектура бэкенда.",
      "displayName": "Архитектура",
      "choices": [
        {
          "choice": "LayeredSingle",
          "description": "Многослойная архитектура в одном проекте: Domain, Application, Endpoints; Infrastructure добавляется при включённом EF Core.",
          "displayName": "Многослойная (в одном проекте)"
        },
        {
          "choice": "LayeredSplit",
          "description": "Многослойная архитектура в разных проектах: Api, Core; Infrastructure добавляется при включённом EF Core.",
          "displayName": "Многослойная (в разных проектах)"
        },
        {
          "choice": "CleanArchitecture",
          "description": "Чистая архитектура: зависимости направлены к домену, реализации в Infrastructure.",
          "displayName": "Чистая архитектура"
        },
        {
          "choice": "CleanArchitectureCqrs",
          "description": "Чистая архитектура + CQRS: MediatR вместо сервисов, handler'ы без behaviors.",
          "displayName": "Чистая архитектура + CQRS (MediatR)"
        }
      ],
      "defaultValue": "CleanArchitectureCqrs"
    },
    "EfCore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Использовать EF Core с PostgreSQL (добавляет слой Infrastructure).",
      "displayName": "Использовать EF Core (PostgreSQL)",
      "defaultValue": true
    },
    "Logging": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Добавить логирование Serilog (консоль, настройка из appsettings.json).",
      "displayName": "Использовать логирование Serilog",
      "defaultValue": true
    },
    "Secrets": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Использовать .NET user secrets для локальных секретов (строка подключения к БД и т.п.).",
      "displayName": "Использовать секреты (.NET user secrets)",
      "defaultValue": true
    },
    "Docker": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Добавить Dockerfile и docker-compose (API + PostgreSQL).",
      "displayName": "Добавить Docker",
      "defaultValue": false
    },
    "Skills": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Добавить библиотеку скиллов для OpenCode и Claude Code.",
      "displayName": "Добавить скиллы для ИИ-агентов",
      "defaultValue": true
    },
    "Tests": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Добавить проект тестов (xUnit, FakeItEasy, FluentAssertions, AutoFixture).",
      "displayName": "Добавить проект тестов",
      "defaultValue": true
    },
    "SkipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Не выполнять автоматическое восстановление пакетов после создания проекта.",
      "displayName": "Не восстанавливать пакеты",
      "defaultValue": "false"
    },
    "UseEfCore": {
      "type": "computed",
      "value": "(EfCore)"
    },
    "UseLogging": {
      "type": "computed",
      "value": "(Logging)"
    },
    "UseSplit": {
      "type": "computed",
      "value": "(Architecture == \"LayeredSplit\")"
    },
    "UseCqrs": {
      "type": "computed",
      "value": "(Architecture == \"CleanArchitectureCqrs\")"
    },
    "UseRazorPages": {
      "type": "computed",
      "value": "(Frontend == \"RazorPages\" || Frontend == \"RazorPagesVue\" || Frontend == \"RazorPagesReact\")"
    },
    "UseClientApp": {
      "type": "computed",
      "value": "(Frontend == \"RazorPagesVue\" || Frontend == \"RazorPagesReact\")"
    },
    "UseBlazor": {
      "type": "computed",
      "value": "(Frontend == \"BlazorWasm\" || Frontend == \"BlazorServer\")"
    },
    "UseSpa": {
      "type": "computed",
      "value": "(Frontend == \"React\" || Frontend == \"Vue\" || Frontend == \"BlazorWasm\")"
    },
    "Scrutor": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Регистрация сервисов через сканирование сборки (Scrutor). При архитектуре CQRS регистрацию выполняет MediatR — галочка ни на что не влияет.",
      "displayName": "Использовать Scrutor"
    },
    "UseScrutor": {
      "type": "computed",
      "value": "(Scrutor)"
    }
  },
  "sources": [
    {
      "source": "../web-content/root/",
      "target": "./",
      "include": [
        "**/*",
        ".gitignore"
      ]
    },
    {
      "source": "../web-content/csproj-web/",
      "target": "Backend/Pnv.Web/",
      "condition": "(!UseSplit && !UseCqrs)",
      "include": [
        "**/*"
      ]
    },
    {
      "source": "../web-content/arch-four-single/",
      "target": "Backend/Pnv.Web/",
      "condition": "(Architecture == \"LayeredSingle\")",
      "include": [
        "**/*"
      ]
    },
    {
      "source": "../web-content/arch-clean/",
