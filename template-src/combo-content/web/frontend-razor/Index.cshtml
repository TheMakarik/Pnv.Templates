@page
@using Pnv.Combo.Web.Application
@inject IGreetingService GreetingService

@{
    ViewData["Title"] = "Приветствия";
}

<h1>Приветствия</h1>

<ul>
    @foreach (var greeting in await GreetingService.GetGreetingsAsync())
    {
        <li>@greeting.Text</li>
    }
</ul>

<p>REST API: <a href="/api/greetings">/api/greetings</a></p>
